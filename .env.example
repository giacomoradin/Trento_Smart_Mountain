# Trento Smart Mountain — Backend environment template
#
# In produzione (Render) imposta queste variabili nella sezione "Environment".
#
# NOTE DI SICUREZZA:
#   - NESSUNA variabile qui dichiarata può essere committata con un valore reale.
#   - JWT_SECRET deve avere entropia >= 256 bit (32+ char random). Genera con:
#       node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   - Ruota JWT_SECRET periodicamente (invalida tutti i token attivi).
#   - BREVO_API_KEY ha permessi limitati: usa una key dedicata SOLO per send-mail,
#     senza permessi di contacts/users/transactional management.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# URL pubblica del backend (usata in email link + deep link mobile).
BASE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/trento_smart_mountain

# ─── Auth ────────────────────────────────────────────────────────────────────
# CRITICO: deve essere segreto. Mai loggare. Ruotare se compromesso.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Durata token. 7d = copre il requisito offline 3 giorni con margine,
# limite max per evitare finestre di abuso troppo ampie post-furto.
# Sprint 3: sostituire con refresh-token rotation (access 15min + refresh 30d).
JWT_EXPIRES_IN=7d

# ─── CORS (solo produzione) ──────────────────────────────────────────────────
# Origin CSV. In dev viene ignorato (CORS permissivo per localhost).
# Esempio: ALLOWED_ORIGINS=https://app.trentosmartmountain.it,https://admin.trentosmartmountain.it
ALLOWED_ORIGINS=

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
# API key Brevo (https://app.brevo.com/settings/keys/api). Permessi minimi:
# solo "transactional emails". MAI esporre al client.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@trentosmartmountain.it
EMAIL_FROM_NAME=Trento Smart Mountain
