{
  "name": "tsm-backend",
  "version": "1.0.0",
  "description": "Trento Smart Mountain Backend - Modular Monolith",
  "main": "backend/src/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "adb:reverse": "node scripts/adb-reverse.mjs",
    "dev": "node scripts/adb-reverse.mjs && nodemon backend/src/server.js",
    "dev:no-adb": "nodemon backend/src/server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "swagger": "node swagger.js"
  },
  "keywords": [],
  "author": "Giacomo Radin",
  "license": "SEE LICENSE IN ROOT",
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.1",
    "mqtt": "^5.0.0",
    "nodemailer": "^8.0.7",
    "socket.io": "^4.7.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "swagger-autogen": "^2.23.7"
  }
}
