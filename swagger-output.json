    "/meteo/": {
      "get": {
        "tags": [
          "Meteo"
        ],
        "summary": "Sincronizza ultima temperatura per codice stazione",
        "description": "Recupera i dati meteo più recenti da una stazione specifica e li salva nel database. Se non viene fornito un codice, usa quello di default.",
        "parameters": [
          {
            "name": "codice",
            "in": "query",
            "description": "Codice della stazione meteo (es. T0129)",
            "required": false,
            "example": "T0129",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sincronizzazione completata con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "64f1a2b3c4d5e6f7g8h9i0j1"
                    },
                    "stationCode": {
                      "type": "string",
